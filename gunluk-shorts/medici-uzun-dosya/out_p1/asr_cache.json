}, "c1|277.07|279.38": {"text": "Loncaların milisleri isyanı ezdi.", "crc": 2453904167, "t0": 276.95, "t1": 279.5, "dt": 9.15, "ch": "c1", "k": 91}, "c1|284.94|285.73": {"text": "Medici adı", "crc": 2252441501, "t0": 284.82, "t1": 285.85, "dt": 3.52, "ch": "c1", "k": 94}, "c1|281.62|283.65": {"text": "en kanlı günlerinden biri sayılır.", "crc": 1199333260, "t0": 281.5, "t1": 283.77, "dt": 7.78, "ch": "c1", "k": 93}, "c1|289.96|290.43": {"text": "Aile", "crc": 2814359865, "t0": 289.84, "t1": 290.55, "dt": 2.66, "ch": "c1", "k": 96}, "c1|290.80|292.38": {"text": "kır gelirleriyle geçiniyordu.", "crc": 3322207531, "t0": 290.68, "t1": 292.5, "dt": 6.28, "ch": "c1", "k": 97}, "c1|286.09|289.29": {"text": "o yıllarda şehrin seçkinlerinin bir kademe altındaydı.", "crc": 104303908, "t0": 285.97, "t1": 289.41, "dt": 12.17, "ch": "c1", "k": 95}, "c1|293.09|293.81": {"text": "bu ailenin", "crc": 2262667143, "t0": 292.97, "t1": 293.93, "dt": 3.38, "ch": "c1", "k": 98}, "c1|294.21|295.99": {"text": "Kovan Nedibitça adlı üyesi,", "crc": 1817348151, "t0": 294.09, "t1": 296.11, "dt": 7.63, "ch": "c1", "k": 99}, "c1|296.42|299.40": {"text": "babasının mütevazı mirasından küçük bir pay aldı.", "crc": 2095278720, "t0": 296.3, "t1": 299.52, "dt": 10.66, "ch": "c1", "k": 100}, "c1|299.64|302.04": {"text": "Vieri di Cambio'nun bankasında çalıştı.", "crc": 297570508, "t0": 299.52, "t1": 302.16, "dt": 7.59, "ch": "c1", "k": 101}, "c1|302.84|303.86": {"text": "Viyeri çekilince,", "crc": 775159472, "t0": 302.72, "t1": 303.98, "dt": 5.14, "ch": "c1", "k": 102}, "c1|304.27|305.87": {"text": "1390'ların başında", "crc": 115569337, "t0": 304.15, "t1": 305.99, "dt": 4.69, "ch": "c1", "k": 103}, "c1|306.31|307.64": {"text": "Roma işinin alacak", "crc": 3098690845, "t0": 306.19, "t1": 307.76, "dt": 4.38, "ch": "c1", "k": 104}, "c1|307.95|309.29": {"text": "ve borçlarını devraldı.", "crc": 4107774520, "t0": 307.83, "t1": 309.41, "dt": 5.92, "ch": "c1", "k": 105}, "c1|310.14|311.26": {"text": "Ortakla karısı", "crc": 4254159798, "t0": 310.02, "t1": 311.38, "dt": 4.46, "ch": "c1", "k": 106}, "c1|311.62|312.78": {"text": "Pikarda Buheri'nin", "crc": 2397897452, "t0": 311.5, "t1": 312.9, "dt": 5.11, "ch": "c1", "k": 107}, "c1|313.18|315.21": {"text": "1500 florynlik çeyzi ile girdi.", "crc": 1712564133, "t0": 313.06, "t1": 315.33, "dt": 8.2, "ch": "c1", "k": 108}, "c1|315.93|317.76": {"text": "Hanedanın ilk sermayesi", "crc": 2283655682, "t0": 315.81, "t1": 317.86, "dt": 5.9, "ch": "c1", "k": 109}, "c1|320.83|322.07": {"text": "1397'de", "crc": 3983621908, "t0": 320.71, "t1": 322.19, "dt": 3.8, "ch": "c1", "k": 111}, "c1|317.95|319.96": {"text": "Diyelim ki bir evlilik sözleşmesiydi", "crc": 2018427472, "t0": 317.86, "t1": 320.08, "dt": 8.84, "ch": "c1", "k": 110}, "c1|322.48|324.43": {"text": "işi Roma'dan Florence'a taşıdı.", "crc": 3240862124, "t0": 322.36, "t1": 324.55, "dt": 7.53, "ch": "c1", "k": 112}, "c1|325.15|326.75": {"text": "Orsan Mikere yakınında", "crc": 1990849465, "t0": 325.03, "t1": 326.85, "dt": 5.44, "ch": "c1", "k": 113}, "c1|326.95|328.38": {"text": "via porta rossa ile", "crc": 1004145742, "t0": 326.85, "t1": 328.48, "dt": 4.25, "ch": "c1", "k": 114}, "c1|328.58|330.61": {"text": "Via Calimala'nın kesiştiği köşeye", "crc": 1395724001, "t0": 328.48, "t1": 330.73, "dt": 8.42, "ch": "c1", "k": 115}, "c1|331.34|333.00": {"text": "Sermaye 10.000 florindi.", "crc": 66420277, "t0": 331.22, "t1": 333.12, "dt": 6.61, "ch": "c1", "k": 116}, "c1|335.73|336.80": {"text": "artık bir masa", "crc": 2406565354, "t0": 335.65, "t1": 336.92, "dt": 3.09, "ch": "c1", "k": 118}, "c1|333.80|335.58": {"text": "Orsan Mikele'nin köşesinde", "crc": 3160292357, "t0": 333.68, "t1": 335.65, "dt": 7.66, "ch": "c1", "k": 117}, "c1|337.12|338.30": {"text": "ve bir defter vardı.", "crc": 733787747, "t0": 337.0, "t1": 338.42, "dt": 5.98, "ch": "c1", "k": 119}, "c1|341.17|341.80": {"text": "Zor olan", "crc": 1899463042, "t0": 341.05, "t1": 341.92, "dt": 3.37, "ch": "c1", "k": 121}, "c1|339.01|340.60": {"text": "Para kazanmanın yolu belliydi", "crc": 907478937, "t0": 338.89, "t1": 340.72, "dt": 7.89, "ch": "c1", "k": 120}, "c1|342.16|342.76": {"text": "kilisenin", "crc": 3625042716, "t0": 342.04, "t1": 342.88, "dt": 3.48, "ch": "c1", "k": 122}, "c1|343.16|344.29": {"text": "Faiz günahtır.", "crc": 3984947046, "t0": 343.04, "t1": 344.41, "dt": 5.74, "ch": "c1", "k": 123}, "c1|344.57|345.69": {"text": "dediği bir çağda", "crc": 3942651892, "t0": 344.45, "t1": 345.81, "dt": 5.07, "ch": "c1", "k": 124}, "c2|350.68|351.40": {"text": "Cambio'daydı", "crc": 4076924026, "t0": 350.56, "t1": 351.52, "dt": 4.19, "ch": "c2", "k": 0}, "c1|346.06|347.54": {"text": "onu huzurla kazanmaktı", "crc": 3374902955, "t0": 345.94, "t1": 347.56, "dt": 6.58, "ch": "c1", "k": 125}, "c2|352.16|352.60": {"text": "Kilise", "crc": 2696962397, "t0": 352.04, "t1": 352.72, "dt": 2.75, "ch": "c2", "k": 1}, "c2|356.44|358.02": {"text": "Bankacılarda bir yol buldular.", "crc": 352569040, "t0": 356.32, "t1": 358.14, "dt": 6.22, "ch": "c2", "k": 3}, "c2|352.93|355.77": {"text": "her türlü faizi tefecilik sahip yasaklamıştı.", "crc": 3368529418, "t0": 352.81, "t1": 355.89, "dt": 11.5, "ch": "c2", "k": 2}, "c2|429.00|430.09": {"text": "Medicinin farkı", "crc": 3794187754, "t0": 428.88, "t1": 430.21, "dt": 4.36, "ch": "c2", "k": 41}, "c2|430.39|431.31": {"text": "defterde değil,", "crc": 2526118766, "t0": 430.27, "t1": 431.43, "dt": 4.37, "ch": "c2", "k": 42}, "c2|431.60|432.22": {"text": "Yapıdaydı.", "crc": 225849437, "t0": 431.48, "t1": 432.34, "dt": 3.99, "ch": "c2", "k": 43}, "c2|434.84|435.88": {"text": "kendi defteri vardı.", "crc": 549506019, "t0": 434.72, "t1": 436.0, "dt": 4.9, "ch": "c2", "k": 45}, "c2|432.78|434.56": {"text": "her şubenin kendi ortaklığı,", "crc": 4253011802, "t0": 432.66, "t1": 434.68, "dt": 6.52, "ch": "c2", "k": 44}, "c2|436.73|437.28": {"text": "Kovanı", "crc": 3905996575, "t0": 436.61, "t1": 437.4, "dt": 3.28, "ch": "c2", "k": 46}, "c2|441.08|44
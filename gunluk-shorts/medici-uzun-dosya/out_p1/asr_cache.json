}, "c1|273.57|275.88": {"text": "Loncaların milisleri isyanı ezdi.", "crc": 2453904167, "t0": 273.45, "t1": 276.0, "dt": 9.15, "ch": "c1", "k": 91}, "c1|281.44|282.23": {"text": "Medici adı", "crc": 2252441501, "t0": 281.32, "t1": 282.35, "dt": 3.52, "ch": "c1", "k": 94}, "c1|278.12|280.15": {"text": "en kanlı günlerinden biri sayılır.", "crc": 1199333260, "t0": 278.0, "t1": 280.27, "dt": 7.78, "ch": "c1", "k": 93}, "c1|286.46|286.93": {"text": "Aile", "crc": 2814359865, "t0": 286.34, "t1": 287.05, "dt": 2.66, "ch": "c1", "k": 96}, "c1|287.30|288.88": {"text": "kır gelirleriyle geçiniyordu.", "crc": 3322207531, "t0": 287.18, "t1": 289.0, "dt": 6.28, "ch": "c1", "k": 97}, "c1|282.59|285.79": {"text": "o yıllarda şehrin seçkinlerinin bir kademe altındaydı.", "crc": 104303908, "t0": 282.47, "t1": 285.91, "dt": 12.17, "ch": "c1", "k": 95}, "c1|289.59|290.31": {"text": "bu ailenin", "crc": 2262667143, "t0": 289.47, "t1": 290.43, "dt": 3.38, "ch": "c1", "k": 98}, "c1|290.71|292.49": {"text": "Kovan Nedibitça adlı üyesi,", "crc": 1817348151, "t0": 290.59, "t1": 292.61, "dt": 7.63, "ch": "c1", "k": 99}, "c1|292.92|295.90": {"text": "babasının mütevazı mirasından küçük bir pay aldı.", "crc": 2095278720, "t0": 292.8, "t1": 296.02, "dt": 10.66, "ch": "c1", "k": 100}, "c1|296.14|298.54": {"text": "Vieri di Cambio'nun bankasında çalıştı.", "crc": 297570508, "t0": 296.02, "t1": 298.66, "dt": 7.59, "ch": "c1", "k": 101}, "c1|299.34|300.36": {"text": "Viyeri çekilince,", "crc": 775159472, "t0": 299.22, "t1": 300.48, "dt": 5.14, "ch": "c1", "k": 102}, "c1|300.77|302.37": {"text": "1390'ların başında", "crc": 115569337, "t0": 300.65, "t1": 302.49, "dt": 4.69, "ch": "c1", "k": 103}, "c1|302.81|304.14": {"text": "Roma işinin alacak", "crc": 3098690845, "t0": 302.69, "t1": 304.26, "dt": 4.38, "ch": "c1", "k": 104}, "c1|304.45|305.79": {"text": "ve borçlarını devraldı.", "crc": 4107774520, "t0": 304.33, "t1": 305.91, "dt": 5.92, "ch": "c1", "k": 105}, "c1|306.64|307.76": {"text": "Ortakla karısı", "crc": 4254159798, "t0": 306.52, "t1": 307.88, "dt": 4.46, "ch": "c1", "k": 106}, "c1|308.12|309.28": {"text": "Pikarda Buheri'nin", "crc": 2397897452, "t0": 308.0, "t1": 309.4, "dt": 5.11, "ch": "c1", "k": 107}, "c1|309.68|311.71": {"text": "1500 florynlik çeyzi ile girdi.", "crc": 1712564133, "t0": 309.56, "t1": 311.83, "dt": 8.2, "ch": "c1", "k": 108}, "c1|312.43|314.26": {"text": "Hanedanın ilk sermayesi", "crc": 2283655682, "t0": 312.31, "t1": 314.36, "dt": 5.9, "ch": "c1", "k": 109}, "c1|317.33|318.57": {"text": "1397'de", "crc": 3983621908, "t0": 317.21, "t1": 318.69, "dt": 3.8, "ch": "c1", "k": 111}, "c1|314.45|316.46": {"text": "Diyelim ki bir evlilik sözleşmesiydi", "crc": 2018427472, "t0": 314.36, "t1": 316.58, "dt": 8.84, "ch": "c1", "k": 110}, "c1|318.98|320.93": {"text": "işi Roma'dan Florence'a taşıdı.", "crc": 3240862124, "t0": 318.86, "t1": 321.05, "dt": 7.53, "ch": "c1", "k": 112}, "c1|321.65|323.25": {"text": "Orsan Mikere yakınında", "crc": 1990849465, "t0": 321.53, "t1": 323.35, "dt": 5.44, "ch": "c1", "k": 113}, "c1|323.45|324.88": {"text": "via porta rossa ile", "crc": 1004145742, "t0": 323.35, "t1": 324.98, "dt": 4.25, "ch": "c1", "k": 114}, "c1|325.08|327.11": {"text": "Via Calimala'nın kesiştiği köşeye", "crc": 1395724001, "t0": 324.98, "t1": 327.23, "dt": 8.42, "ch": "c1", "k": 115}, "c1|327.84|329.50": {"text": "Sermaye 10.000 florindi.", "crc": 66420277, "t0": 327.72, "t1": 329.62, "dt": 6.61, "ch": "c1", "k": 116}, "c1|332.23|333.30": {"text": "artık bir masa", "crc": 2406565354, "t0": 332.15, "t1": 333.42, "dt": 3.09, "ch": "c1", "k": 118}, "c1|330.30|332.08": {"text": "Orsan Mikele'nin köşesinde", "crc": 3160292357, "t0": 330.18, "t1": 332.15, "dt": 7.66, "ch": "c1", "k": 117}, "c1|333.62|334.80": {"text": "ve bir defter vardı.", "crc": 733787747, "t0": 333.5, "t1": 334.92, "dt": 5.98, "ch": "c1", "k": 119}, "c1|337.67|338.30": {"text": "Zor olan", "crc": 1899463042, "t0": 337.55, "t1": 338.42, "dt": 3.37, "ch": "c1", "k": 121}, "c1|335.51|337.10": {"text": "Para kazanmanın yolu belliydi", "crc": 907478937, "t0": 335.39, "t1": 337.22, "dt": 7.89, "ch": "c1", "k": 120}, "c1|338.66|339.26": {"text": "kilisenin", "crc": 3625042716, "t0": 338.54, "t1": 339.38, "dt": 3.48, "ch": "c1", "k": 122}, "c1|339.66|340.79": {"text": "Faiz günahtır.", "crc": 3984947046, "t0": 339.54, "t1": 340.91, "dt": 5.74, "ch": "c1", "k": 123}, "c1|341.07|342.19": {"text": "dediği bir çağda", "crc": 3942651892, "t0": 340.95, "t1": 342.31, "dt": 5.07, "ch": "c1", "k": 124}, "c2|347.18|347.90": {"text": "Cambio'daydı", "crc": 4076924026, "t0": 347.06, "t1": 348.02, "dt": 4.19, "ch": "c2", "k": 0}, "c1|342.56|344.04": {"text": "onu huzurla kazanmaktı", "crc": 3374902955, "t0": 342.44, "t1": 344.06, "dt": 6.58, "ch": "c1", "k": 125}, "c2|348.66|349.10": {"text": "Kilise", "crc": 2696962397, "t0": 348.54, "t1": 349.22, "dt": 2.75, "ch": "c2", "k": 1}, "c2|352.94|354.52": {"text": "Bankacılarda bir yol buldular.", "crc": 352569040, "t0": 352.82, "t1": 354.64, "dt": 6.22, "ch": "c2", "k": 3}, "c2|349.43|352.27": {"text": "her türlü faizi tefecilik sahip yasaklamıştı.", "crc": 3368529418, "t0": 349.31, "t1": 352.39, "dt": 11.5, "ch": "c2", "k": 2}, "c2|425.50|426.59": {"text": "Medicinin farkı", "crc": 3794187754, "t0": 425.38, "t1": 426.71, "dt": 4.36, "ch": "c2", "k": 41}, "c2|426.89|427.81": {"text": "defterde değil,", "crc": 2526118766, "t0": 426.77, "t1": 427.93, "dt": 4.37, "ch": "c2", "k": 42}, "c2|428.10|428.72": {"text": "Yapıdaydı.", "crc": 225849437, "t0": 427.98, "t1": 428.84, "dt": 3.99, "ch": "c2", "k": 43}, "c2|431.34|432.38": {"text": "kendi defteri vardı.", "crc": 549506019, "t0": 431.22, "t1": 432.5, "dt": 4.9, "ch": "c2", "k": 45}, "c2|429.28|431.06": {"text": "her şubenin kendi ortaklığı,", "crc": 4253011802, "t0": 429.16, "t1": 431.18, "dt": 6.52, "ch": "c2", "k": 44}, "c2|433.23|433.78": {"text": "Kovanı", "crc": 3905996575, "t0": 433.11, "t1": 433.9, "dt": 3.28, "ch": "c2", "k": 46}, "c2|437.58|43
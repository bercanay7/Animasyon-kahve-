3.02, "dt": 6.43, "ch": "c3", "k": 16}, "c3|26.99|30.25": {"text": "halk yönetiminde kendini sıradan yurttaşın üstüne çıkarmaktı", "crc": 3458397375, "t0": 26.87, "t1": 30.37, "dt": 9.47, "ch": "c3", "k": 15}, "c3|33.74|34.97": {"text": "Aynı Machiavelli'ye", "crc": 1611538055, "t0": 33.62, "t1": 35.09, "dt": 4.72, "ch": "c3", "k": 17}, "c3|35.41|37.17": {"text": "Kozimo zehirlenmekten korkup", "crc": 57518943, "t0": 35.29, "t1": 37.29, "dt": 5.94, "ch": "c3", "k": 18}, "c3|37.58|38.63": {"text": "Yalnız ekmek yedi.", "crc": 2784455118, "t0": 37.46, "t1": 38.75, "dt": 4.24, "ch": "c3", "k": 19}, "c3|39.28|39.68": {"text": "Bekçi", "crc": 3987765985, "t0": 39.16, "t1": 39.8, "dt": 2.84, "ch": "c3", "k": 20}, "c3|42.55|43.39": {"text": "Onu rahatlattı.", "crc": 1330165725, "t0": 42.43, "t1": 43.51, "dt": 3.9, "ch": "c3", "k": 22}, "c3|40.02|42.16": {"text": "getirilen her yemekten kendisi yiyerek", "crc": 1797628656, "t0": 39.9, "t1": 42.28, "dt": 5.81, "ch": "c3", "k": 21}, "c3|44.07|45.33": {"text": "Yine ona göre Kozimo,", "crc": 3442466233, "t0": 43.95, "t1": 45.45, "dt": 5.01, "ch": "c3", "k": 23}, "c3|45.65|47.54": {"text": "Aracısına küçük bir kağıt verdi.", "crc": 3898892467, "t0": 45.53, "t1": 47.66, "dt": 5.93, "ch": "c3", "k": 24}, "c3|51.08|52.41": {"text": "1100 Duka çekildi.", "crc": 4239075207, "t0": 50.985, "t1": 52.53, "dt": 4.55, "ch": "c3", "k": 26}, "c3|48.22|50.89": {"text": "Santa Maria Nova Hastanesi'nin Başkanı'ndan", "crc": 2465038279, "t0": 48.1, "t1": 50.985, "dt": 7.98, "ch": "c3", "k": 25}, "c3|52.87|54.44": {"text": "Bini Gonfaloniere'ye gitti.", "crc": 3769701594, "t0": 52.75, "t1": 54.56, "dt": 5.53, "ch": "c3", "k": 27}, "c3|55.16|56.05": {"text": "Ölüm cezası", "crc": 4105995151, "t0": 55.04, "t1": 56.17, "dt": 3.61, "ch": "c3", "k": 28}, "c3|57.89|58.77": {"text": "Aradaki fark", "crc": 1763757713, "t0": 57.77, "t1": 58.89, "dt": 2.78, "ch": "c3", "k": 30}, "c3|56.39|57.22": {"text": "sürgüne döndü", "crc": 1049956103, "t0": 56.27, "t1": 57.34, "dt": 3.87, "ch": "c3", "k": 29}, "c3|59.21|60.23": {"text": "Küçük bir kağıdı", "crc": 2626847165, "t0": 59.09, "t1": 60.35, "dt": 4.51, "ch": "c3", "k": 31}, "c3|61.05|63.25": {"text": "3 Ekim 1433'te Kozimo,", "crc": 1592768362, "t0": 60.93, "t1": 63.37, "dt": 7.4, "ch": "c3", "k": 32}, "c3|63.72|65.27": {"text": "Singoria'nın önüne çıktı.", "crc": 1448904473, "t0": 63.6, "t1": 65.39, "dt": 5.65, "ch": "c3", "k": 33}, "c3|67.64|68.24": {"text": "Kaynaklar,", "crc": 3090688022, "t0": 67.52, "t1": 68.36, "dt": 3.76, "ch": "c3", "k": 35}, "c3|65.62|66.95": {"text": "ve Padova'ya gönderild", "crc": 968765482, "t0": 65.5, "t1": 67.07, "dt": 6.48, "ch": "c3", "k": 34}, "c3|70.82|71.93": {"text": "Bir yıl diyen de var.", "crc": 3146017988, "t0": 70.7, "t1": 72.05, "dt": 5.63, "ch": "c3", "k": 37}, "c3|68.54|70.30": {"text": "Sürgünün süresinde anlaşamıyor", "crc": 151935830, "t0": 68.42, "t1": 70.42, "dt": 8.19, "ch": "c3", "k": 36}, "c3|72.26|73.30": {"text": "20 yıl diyende.", "crc": 40706970, "t0": 72.14, "t1": 73.42, "dt": 4.25, "ch": "c3", "k": 38}, "c3|73.80|74.67": {"text": "Çoğalnatı", "crc": 3698313833, "t0": 73.68, "t1": 74.72, "dt": 4.88, "ch": "c3", "k": 39}, "c3|74.77|75.13": {"text": "10 yıl.", "crc": 2552469761, "t0": 74.72, "t1": 75.25, "dt": 3.25, "ch": "c3", "k": 40}, "c3|78.31|78.78": {"text": "Venedik!", "crc": 1920122107, "t0": 78.19, "t1": 78.9, "dt": 3.56, "ch": "c3", "k": 42}, "c3|75.99|77.63": {"text": "Çok geçmeden Venedi'ye geçti.", "crc": 1074938942, "t0": 75.87, "t1": 77.75, "dt": 7.19, "ch": "c3", "k": 41}, "c3|79.17|80.97": {"text": "Onu bir diplomat gibi karşıladı.", "crc": 84694794, "t0": 79.05, "t1": 81.09, "dt": 6.46, "ch": "c3", "k": 43}, "c3|83.73|84.22": {"text": "Yanında", "crc": 788044227, "t0": 83.61, "t1": 84.34, "dt": 2.63, "ch": "c3", "k": 45}, "c3|81.23|83.01": {"text": "ve Floransa'ya elçi gönderdi.", "crc": 4194998038, "t0": 81.11, "t1": 83.13, "dt": 7.39, "ch": "c3", "k": 44}, "c3|86.81|87.32": {"text": "Bu sırada", "crc": 94304461, "t0": 86.69, "t1": 87.44, "dt": 3.19, "ch": "c3", "k": 47}, "c3|84.56|85.96": {"text": "Mimar Mikheil Otso vardı.", "crc": 2033818913, "t0": 84.44, "t1": 86.08, "dt": 6.23, "ch": "c3", "k": 46}, "c3|90.15|91.47": {"text": "Ağustos sonunda Kura,", "crc": 3259878683, "t0": 90.03, "t1": 91.59, "dt": 6.52, "ch": "c3", "k": 49}, "c3|87.68|89.46": {"text": "Floransa'da rüzgar değişiyordu.", "crc": 2063170904, "t0": 87.56, "t1": 89.58, "dt": 7.76, "ch": "c3", "k": 48}, "c3|94.80|96.47": {"text": "Rinaldo Deli Albiç ise", "crc": 839331322, "t0": 94.68, "t1": 96.59, "dt": 6.25, "ch": "c3", "k": 51}, "c3|91.91|94.04": {"text": "Kozimo yalnızı bir Signoria çıkardı.", "crc": 599947779, "t0": 91.79, "t1": 94.16, "dt": 8.03, "ch": "c3", "k": 50}, "c3|96.90|97.60": {"text": "Ona karşı", "crc": 3222265885, "t0": 96.78, "t1": 97.72, "dt": 2.65, "ch": "c3", "k": 52}, "c3|101.43|102.27": {"text": "Eylül sonunda", "crc": 3632205110, "t0": 101.31, "t1": 102.39, "dt": 4.3, "ch": "c3", "k": 54}, "c3|97.98|100.54": {"text": "olağanüstü yetkili bir kurul toplatmaya çalıştı", "crc": 628415330, "t0": 97.86, "t1": 100.66, "dt": 10.35, "ch": "c3", "k": 53}, "c3|102.58|103.93": {"text": "sürgün kararı kalktı.", "crc": 40326686, "t0": 102.46, "t1": 104.05, "dt": 6.0, "ch": "c3", "k": 55}, "c3|104.46|106.42": {"text": "6 Ekim 1434'te", "crc": 388840072, "t0": 104.34, "t1": 106.54, "dt": 5.62, "ch": "c3", "k": 56}, "c3|106.85|108.42": {"text": "Kozimo, Florença'ya dönd", "crc": 1748657667, "t0": 106.73, "t1": 108.54, "dt": 6.85, "ch": "c3", "k": 57}, "c3|114.00|115.58": {"text": "Rinaldo Deli Albiçsi ile", "crc": 2452873070, "t0": 113.88, "t1": 115.7, "dt": 7.49, "ch": "c3", "k": 59}, "c3|115.97|117.25": {"text": "1427'de", "crc": 3744693380, "t0": 115.85, "t1": 117.37, "dt": 3.92, "ch": "c3", "k": 60}, "c3|109.20|112.91": {"text": "Albiçlilerin ıssız kalmış konaklarının önünden geçtiği anlatıl", "crc": 3688777584, "t0": 109.08, "t1": 113.03, "dt": 15.07, "ch": "c3", "k": 58}
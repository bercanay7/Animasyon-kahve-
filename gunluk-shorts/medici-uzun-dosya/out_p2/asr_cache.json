, "t1": 349.57, "dt": 5.73, "ch": "c4", "k": 66}, "c4|350.76|352.34": {"text": "modern bir yazarın cümlesi.", "crc": 3061172010, "t0": 350.64, "t1": 352.46, "dt": 7.99, "ch": "c4", "k": 68}, "c4|352.96|355.04": {"text": "Papa'nın kendi sözü olarak kayıtlı değil.", "crc": 4182171731, "t0": 352.84, "t1": 355.16, "dt": 8.67, "ch": "c4", "k": 69}, "c4|355.95|357.06": {"text": "keşiş değildi ama", "crc": 3903999013, "t0": 355.83, "t1": 357.18, "dt": 6.47, "ch": "c4", "k": 70}, "c4|357.40|358.60": {"text": "başı sayesinde", "crc": 3447899111, "t0": 357.28, "t1": 358.72, "dt": 3.62, "ch": "c4", "k": 71}, "c4|361.53|362.32": {"text": "biri kendine", "crc": 4223154857, "t0": 361.41, "t1": 362.44, "dt": 2.64, "ch": "c4", "k": 73}, "c4|358.92|360.93": {"text": "San Marco'da iki hücresi vardı.", "crc": 3807643308, "t0": 358.8, "t1": 361.05, "dt": 6.18, "ch": "c4", "k": 72}, "c4|362.70|363.91": {"text": "biri önemli konuklara.", "crc": 223749508, "t0": 362.58, "t1": 364.03, "dt": 3.83, "ch": "c4", "k": 74}, "c4|364.62|364.90": {"text": "Evet.", "crc": 2111830829, "t0": 364.5, "t1": 365.02, "dt": 2.19, "ch": "c4", "k": 75}, "c4|368.11|369.26": {"text": "Medici tek değildi.", "crc": 4197423823, "t0": 367.99, "t1": 369.38, "dt": 3.9, "ch": "c4", "k": 77}, "c4|365.39|367.22": {"text": "Konuk odası o zaman da kıyakmış.", "crc": 3134252155, "t0": 365.27, "t1": 367.34, "dt": 6.37, "ch": "c4", "k": 76}, "c4|369.86|370.95": {"text": "Kovanni Rucellay", "crc": 828348873, "t0": 369.74, "t1": 371.07, "dt": 4.25, "ch": "c4", "k": 78}, "c4|371.28|372.50": {"text": "kendi defterine yazdı.", "crc": 772276065, "t0": 371.16, "t1": 372.62, "dt": 4.05, "ch": "c4", "k": 79}, "c4|373.11|373.89": {"text": "50 yıl hep", "crc": 3353244700, "t0": 372.99, "t1": 373.94, "dt": 2.31, "ch": "c4", "k": 80}, "c4|373.99|375.04": {"text": "kazanıp harcamış,", "crc": 3979915263, "t0": 373.94, "t1": 375.16, "dt": 4.08, "ch": "c4", "k": 81}, "c4|378.77|379.80": {"text": "Palastroci", "crc": 400532840, "t0": 378.65, "t1": 379.92, "dt": 3.18, "ch": "c4", "k": 83}, "c4|375.48|377.80": {"text": "harcamayı kazanmaktan daha tatlı bulmuş.", "crc": 2565959844, "t0": 375.36, "t1": 377.92, "dt": 7.21, "ch": "c4", "k": 82}, "c4|383.46|385.22": {"text": "soyadını sanki imzalamış.", "crc": 2142059126, "t0": 383.34, "t1": 385.34, "dt": 5.48, "ch": "c4", "k": 85}, "c4|380.21|383.06": {"text": "ısmarladığı 3 kralın tapınışı tablosunda", "crc": 2003928825, "t0": 380.09, "t1": 383.18, "dt": 8.49, "ch": "c4", "k": 84}, "c4|388.54|389.32": {"text": "Stratıyer'e", "crc": 857279599, "t0": 388.42, "t1": 389.44, "dt": 3.59, "ch": "c4", "k": 87}, "c4|385.84|388.04": {"text": "Maiyetin arasında bir Şahinci var.", "crc": 3823875783, "t0": 385.72, "t1": 388.16, "dt": 5.93, "ch": "c4", "k": 86}, "c4|391.42|392.19": {"text": "Stratisiler", "crc": 991473766, "t0": 391.3, "t1": 392.31, "dt": 2.73, "ch": "c4", "k": 89}, "c4|389.67|390.57": {"text": "Şahinci demek.", "crc": 4174555563, "t0": 389.55, "t1": 390.69, "dt": 3.31, "ch": "c4", "k": 88}, "c4|392.55|394.01": {"text": "1489'da", "crc": 2776509074, "t0": 392.43, "t1": 394.13, "dt": 3.09, "ch": "c4", "k": 90}, "c4|394.39|396.75": {"text": "Medici sarayını aşacak bir saraya başladı.", "crc": 1692409974, "t0": 394.27, "t1": 396.87, "dt": 6.78, "ch": "c4", "k": 91}, "c4|397.38|399.32": {"text": "Temel gününü bir astrolog seçti.", "crc": 2385656240, "t0": 397.26, "t1": 399.44, "dt": 5.62, "ch": "c4", "k": 92}, "c4|400.27|401.44": {"text": "Medicinin rakibi", "crc": 3531324062, "t0": 400.15, "t1": 401.56, "dt": 3.5, "ch": "c4", "k": 93}, "c4|401.79|403.05": {"text": "Patsy ailesi de", "crc": 332525849, "t0": 401.67, "t1": 403.17, "dt": 4.21, "ch": "c4", "k": 94}, "c4|406.74|407.23": {"text": "O haden", "crc": 834321981, "t0": 406.62, "t1": 407.35, "dt": 2.48, "ch": "c4", "k": 96}, "c4|407.59|409.00": {"text": "1478'de", "crc": 851553570, "t0": 407.47, "t1": 409.12, "dt": 2.86, "ch": "c4", "k": 97}, "c4|403.33|406.10": {"text": "Brunelleschi'ye atfedilen bir şapeli ısmarlamış", "crc": 2532787733, "t0": 403.21, "t1": 406.22, "dt": 9.11, "ch": "c4", "k": 95}, "c4|411.31|412.38": {"text": "onlar bilmiyordu.", "crc": 3811448866, "t0": 411.19, "t1": 412.44, "dt": 3.89, "ch": "c4", "k": 99}, "c4|409.32|410.96": {"text": "nasıl anılacağını biliyoruz.", "crc": 3562768230, "t0": 409.2, "t1": 411.08, "dt": 4.74, "ch": "c4", "k": 98}, "c4|412.50|413.85": {"text": "Vazariye göre Kozimo,", "crc": 855172294, "t0": 412.44, "t1": 413.97, "dt": 4.9, "ch": "c4", "k": 100}, "c4|418.48|418.89": {"text": "Lipe", "crc": 852992002, "t0": 418.36, "t1": 419.01, "dt": 2.17, "ch": "c4", "k": 102}, "c4|414.28|417.69": {"text": "Fıra Filippo Lippi'yi çalışsın diye evinde bir odaya kilit", "crc": 3276991760, "t0": 414.16, "t1": 417.81, "dt": 10.92, "ch": "c4", "k": 101}, "c4|419.27|420.67": {"text": "Çarşafları makasla kes", "crc": 464236568, "t0": 419.15, "t1": 420.725, "dt": 5.24, "ch": "c4", "k": 103}, "c4|420.78|421.44": {"text": "İp yapmış.", "crc": 1015586316, "t0": 420.725, "t1": 421.56, "dt": 3.1, "ch": "c4", "k": 104}, "c4|421.83|422.77": {"text": "Pencereden inmiş.", "crc": 390222310, "t0": 421.71, "t1": 422.89, "dt": 3.66, "ch": "c4", "k": 105}, "c4|423.42|424.59": {"text": "Kozimo'da pişman ol", "crc": 2632119613, "t0": 423.3, "t1": 424.71, "dt": 4.36, "ch": "c4", "k": 106}, "c4|425.04|426.26": {"text": "ona serbestlik tanımış.", "crc": 1429760998, "t0": 424.92, "t1": 426.38, "dt": 4.95, "ch": "c4", "k": 107}, "c4|427.23|428.91": {"text": "Yıllar sonra genç Lorenzo,", "crc": 2671459992, "t0": 427.11, "t1": 429.03, "dt": 8.73, "ch": "c4", "k": 108}, "c4|429.35|430.71": {"text": "Aydem'in defterini aç", "crc": 2692836362, "t0": 429.23, "t1": 430.83, "dt": 10.38, "ch": "c4", "k": 109}, "c4|431.35|432.66": {"text": "1434'ten", "crc": 2595998571, "t0": 431.23, "t1": 432.78, "dt": 6.41, "ch": "c4", "k": 110}, "c4|433.02|434.73": {"text": "1471'e sadaka", "crc": 2126722850, "t0": 432.9, "t1": 434.85, "dt": 7.49, "ch": "c4", "k": 111}, "c4|435.10|
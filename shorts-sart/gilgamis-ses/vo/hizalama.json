[{"id": "C1", "parca": "Yedi gündür uyuyorsun.", "s": 0.04, "e": 1.67}, {"id": "C2", "parca": "Başucunda yedi ekmek var.", "s": 2.17, "e": 3.77}, {"id": "C3", "parca": "Birincisi taş gibi kurumuş.", "s": 4.25, "e": 6.28}, {"id": "C4", "parca": "Beşincisi küflenmiş.", "s": 6.81, "e": 8.38}, {"id": "C5", "parca": "Yedincisi hâlâ közde.", "s": 8.95, "e": 10.67}, {"id": "C6", "parca": "Her biri,", "s": 11.21, "e": 11.9}, {"id": "C6", "parca": "uyuduğun bir gün.", "s": 12.21, "e": 13.24}, {"id": "C7", "parca": "Ölümsüzlük için tek şart vardı:", "s": 13.78, "e": 15.63}, {"id": "C7", "parca": "altı gün, yedi gece uyumamak.", "s": 16.1, "e": 18.25}, {"id": "C8", "parca": "Ölümü yenmeye gelmiştin, Gılgamış.", "s": 18.66, "e": 20.71}, {"id": "C9", "parca": "Bir uykuyu yenemedin.", "s": 21.08, "e": 22.33}, {"id": "C10", "parca": "Oysa yalnızca oturdun…", "s": 22.73, "e": 24.34}, {"id": "C10", "parca": "ve gözünü bir an kapadın.", "s": 24.75, "e": 26.32}]